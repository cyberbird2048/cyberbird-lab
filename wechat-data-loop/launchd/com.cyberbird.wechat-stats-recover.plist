<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 用法：
  1. 复制到 ~/Library/LaunchAgents/
  2. 把所有 <YOUR_USERNAME> 替换成你的用户名
  3. 确认 uv 路径（默认 ~/.local/bin/uv，用 `which uv` 查）
  4. 确认 fetch_stats.py 的绝对路径
  5. launchctl load -w ~/Library/LaunchAgents/com.cyberbird.wechat-stats-recover.plist
  日志在 ~/Library/Logs/wechat-stats-recover.log
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.cyberbird.wechat-stats-recover</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/<YOUR_USERNAME>/.local/bin/uv</string>
        <string>run</string>
        <string>--with</string>
        <string>websocket-client</string>
        <string>python3</string>
        <string>/Users/<YOUR_USERNAME>/cyberbird-lab/wechat-data-loop/fetch_stats.py</string>
        <string>--output</string>
        <string>/Users/<YOUR_USERNAME>/cyberbird-lab/wechat-data-loop/output</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/<YOUR_USERNAME>/cyberbird-lab/wechat-data-loop</string>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>11</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/Users/<YOUR_USERNAME>/Library/Logs/wechat-stats-recover.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/<YOUR_USERNAME>/Library/Logs/wechat-stats-recover.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/<YOUR_USERNAME>/.local/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/<YOUR_USERNAME></string>
    </dict>
</dict>
</plist>
